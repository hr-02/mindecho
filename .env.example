# Copy this file to .env for LOCAL DEVELOPMENT ONLY.
# On Cloud Run, do NOT set GEMINI_API_KEY as plaintext — the app pulls it
# from Secret Manager automatically instead (see README "Deploy" section).

# Port the server listens on (Cloud Run sets this automatically in production)
PORT=8080

# Your Google Cloud project ID (needed so the server can find your Secret
# Manager secret and your Firebase project)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Name of the Secret Manager secret holding your Gemini API key.
# Only used to look the key up — the key itself is never stored here.
GEMINI_SECRET_NAME=gemini-api-key

# LOCAL DEV SHORTCUT ONLY: if this is set, the server uses it directly
# instead of calling Secret Manager. Leave unset/blank in production.
GEMINI_API_KEY=

# Which Gemini model to use. Check https://ai.google.dev for current model
# names — this default may not be the newest model by the time you build.
GEMINI_MODEL=gemini-2.5-flash

# Path to a Firebase service account JSON key, for LOCAL DEV ONLY.
# On Cloud Run this is not needed — the service's own identity is used.
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
