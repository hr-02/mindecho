rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Each user can only ever read or write their OWN journal entries.
    // This is the "zero cross-user leakage" requirement enforced at the
    // database level, not just in application code.
    match /users/{userId}/entries/{entryId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Optional user profile doc, same isolation rule.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // The "shares" collection (revocable trust-circle links) is deliberately
    // NOT exposed here. It is only ever read or written by the backend
    // using the Admin SDK, which bypasses these rules entirely. Client SDKs
    // — including an attacker with just the Firebase config, which is
    // public by design — get no access to it at all.
    match /shares/{shareId} {
      allow read, write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
